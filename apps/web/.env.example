# ---------------------------------------------------------------------------
# Next.js web app (apps/web)
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used by Prisma at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/yournote?sslmode=require"
# Direct connection, used by Prisma Migrate. Note: no "-pooler" in the host.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/yournote?sslmode=require"

# --- Better Auth -----------------------------------------------------------
# Generate one with: openssl rand -base64 32
# The Go API must be given the exact same value.
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only needed in production when the API lives on a sibling subdomain,
# e.g. ".yournote.app" so api.yournote.app receives the session cookie.
# COOKIE_DOMAIN=".yournote.app"

# --- Google sign-in --------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin bootstrap -------------------------------------------------------
# Comma separated. These addresses get the admin role the moment they sign up.
ADMIN_EMAILS="you@example.com"

# --- Go API ----------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8080"

# --- Email (optional in development) ---------------------------------------
# Without these, verification codes are printed to the terminal instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="YourNote <no-reply@yournote.app>"
