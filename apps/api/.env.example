# ---------------------------------------------------------------------------
# Go API (apps/api)
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

APP_ENV="development"
PORT="8080"

# --- Database --------------------------------------------------------------
# The same Neon database the web app uses. Prefer the pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/yournote?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Must be byte-for-byte the same value as BETTER_AUTH_SECRET in apps/web/.env.
# The API resolves Better Auth sessions against the database with it.
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-string"

# Also verify the HMAC signature on the session cookie, on top of the database
# lookup of the opaque token. Defence in depth; off by default.
AUTH_STRICT_COOKIE_SIGNATURE="false"

# --- CORS ------------------------------------------------------------------
# Comma separated list of web origins allowed to send credentialed requests.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Cloudinary ------------------------------------------------------------
# The API signs browser uploads and deletes orphaned assets. The secret never
# reaches the browser. Without these, file uploads are disabled.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="yournote"

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_REQUESTS="300"
RATE_LIMIT_WINDOW_SECONDS="60"
REQUEST_TIMEOUT_SECONDS="30"
